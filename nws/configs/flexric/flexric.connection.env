# Shell environment for host-side FlexRIC / Python xApps.
# Usage: source nws/configs/flexric/flexric.connection.env
#
# Prerequisites: ./build_flexric.sh and reachable nearRT-RIC (Docker or local).

# Repo layout (override if you source from another cwd)
_NWS_CONFIG_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
_NWS_DIR="$(cd "${_NWS_CONFIG_DIR}/../.." && pwd)"
_OAI_ROOT="${OAI_ROOT:-${_NWS_DIR}/../openairinterface5g}"
_FLEXRIC_ROOT="${FLEXRIC_ROOT:-${_OAI_ROOT}/openair2/E2AP/flexric}"

# nearRT-RIC (must match [NEAR-RIC] NEAR_RIC_IP in flexric.conf and gNB e2_agent.near_ric_ip_addr)
export NEAR_RIC_IP="${NEAR_RIC_IP:-192.168.201.142}"
export NEAR_RIC_PORT="${NEAR_RIC_PORT:-36422}"

# FlexRIC config file (nearRT-RIC -c / xApp init_conf)
export FLEXRIC_CONF="${FLEXRIC_CONF:-${_NWS_CONFIG_DIR}/flexric.conf}"

# Python xApp SDK (after build_flexric.sh)
export PYTHONPATH="${_FLEXRIC_ROOT}/build/examples/xApp/python3:${PYTHONPATH:-}"

# Optional: gNB E2 target (documentation / scripts)
export GNB_NEAR_RIC_IP="${GNB_NEAR_RIC_IP:-${NEAR_RIC_IP}}"

unset _NWS_CONFIG_DIR _NWS_DIR _OAI_ROOT _FLEXRIC_ROOT
