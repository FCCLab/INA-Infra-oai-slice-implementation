# SPDX-License-Identifier: LicenseRef-CSSL-1.0
#
# Quick oai-nr-ue image: local nr-uesoftmodem + matching runtime .so (same cmake tree as gNB).
# Used by nws/build_scripts/build_oai_nr_ue_quick.sh

ARG UBUNTU_IMAGE=ubuntu:noble
FROM ran-build:latest AS nr-ue-build

FROM ran-base:latest AS nr-ue-base

FROM ${UBUNTU_IMAGE} AS oai-nr-ue
ARG BUILD_OPTION
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Europe/Paris
ENV PATH="/opt/oai-nr-ue/bin:$PATH"

RUN apt-get update && \
    apt-get upgrade --yes && \
    apt-get install --yes \
        arping \
        software-properties-common \
        procps \
        libsctp1 \
        libboost-chrono1.83.0 \
        libboost-date-time1.83.0 \
        libboost-filesystem1.83.0 \
        libboost-regex1.83.0 \
        libboost-serialization1.83.0 \
        libboost-thread1.83.0 \
        libboost-system1.83.0 \
        libboost-program-options1.83.0 \
        tzdata \
        libconfig9 \
        openssl \
        net-tools \
        gdb \
        python3 \
        python3-six \
        python3-requests \
        libusb-1.0-0 \
        iputils-ping \
        iproute2 \
        iperf3 \
        iperf \
        libyaml-cpp-dev \
        libzstd1 \
        libnanomsg5 \
        libzmq5 && \
    ln -sf /lib/aarch64-linux-gnu/libyaml-cpp.so.0.8 /lib/aarch64-linux-gnu/libyaml-cpp.so.0.7 && \
    ln -sf /lib/x86_64-linux-gnu/libyaml-cpp.so.0.8 /lib/x86_64-linux-gnu/libyaml-cpp.so.0.7 2>/dev/null || true && \
    /bin/bash -c 'if [[ "$BUILD_OPTION" = "--sanitize" ]]; then DEBIAN_FRONTEND=noninteractive apt-get install --yes \
        libasan8 \
        libubsan1; fi' && \
    apt-get clean -y && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /opt/oai-nr-ue/bin
COPY nws/build_scripts/staging/nr-uesoftmodem ./
COPY openairinterface5g/docker/scripts/nr_ue_entrypoint.sh ./entrypoint.sh

# Same .so tree as gNB quick build (must match nr-uesoftmodem + librfsimulator)
COPY nws/build_scripts/staging/libs/*.so /usr/local/lib/

# Optional tracer / fmtlog deps from last ran-build if present
COPY --from=nr-ue-build \
    /oai-ran/cmake_targets/ran_build/build/common/utils/T/tracer/record* \
    ./
COPY --from=nr-ue-build \
    /oai-ran/cmake_targets/ran_build/build/_deps*/fmtlog-build*/libfmtlog-shared*.so \
    /oai-ran/cmake_targets/ran_build/build/_deps*/clickhouse-cpp-build*/clickhouse/libclickhouse*.so \
    /usr/local/lib/

COPY --from=nr-ue-base /usr/local/bin/uhd_find_devices /usr/local/bin
COPY --from=nr-ue-base /usr/local/lib/libuhd.so.4.8.0 /usr/local/lib
COPY --from=nr-ue-base /usr/local/lib/uhd/utils/uhd_images_downloader.py /opt/oai-nr-ue/bin
COPY --from=nr-ue-base /usr/local/lib/libbladeRF* /usr/local/lib/

RUN /bin/bash -c "ln -s /usr/local/lib/liboai_usrpdevif.so /usr/local/lib/liboai_device.so" && \
    ldconfig && \
    echo "---- quick build: ldd nr-uesoftmodem ----" && \
    ldd /opt/oai-nr-ue/bin/nr-uesoftmodem

WORKDIR /opt/oai-nr-ue
COPY openairinterface5g/common/utils/T/T_messages.txt ./
COPY --from=nr-ue-base /usr/local/bin/yq /usr/local/bin/yq
COPY --from=nr-ue-base /tini /tini
CMD ["/opt/oai-nr-ue/bin/nr-uesoftmodem"]
ENTRYPOINT ["/tini", "-v", "--", "/opt/oai-nr-ue/bin/entrypoint.sh"]
