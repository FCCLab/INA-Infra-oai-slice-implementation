# SPDX-License-Identifier: LicenseRef-CSSL-1.0
#
# Quick oai-gnb image: local nr-softmodem + librfsimulator; FlexRIC SM plugins from staging.
# Used by nws/build_scripts/build_oai_gnb_quick.sh (no full docker build_oai).
# Build context: workspace root (see build_oai_gnb_quick.sh).

ARG UBUNTU_IMAGE=ubuntu:noble
FROM ran-base:latest AS gnb-base

FROM ${UBUNTU_IMAGE} AS oai-gnb
ARG BUILD_OPTION
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Europe/Paris

RUN apt-get update && \
    apt-get upgrade --yes && \
    apt-get install --yes \
        software-properties-common \
        procps \
        libsctp1 \
        libboost-chrono1.83.0 \
        libboost-date-time1.83.0 \
        libboost-filesystem1.83.0 \
        libboost-regex1.83.0 \
        libboost-serialization1.83.0 \
        libboost-thread1.83.0 \
        libboost-system1.83.0 \
        libboost-program-options1.83.0 \
        tzdata \
        libconfig9 \
        openssl \
        net-tools \
        iperf \
        iperf3 \
        iproute2 \
        iputils-ping \
        gdb \
        python3 \
        python3-six \
        python3-requests \
        libusb-1.0-0 \
        libyaml-cpp-dev \
        libnanomsg5 \
        libzmq5 && \
    ln -sf /lib/aarch64-linux-gnu/libyaml-cpp.so.0.8 /lib/aarch64-linux-gnu/libyaml-cpp.so.0.7 && \
    ln -sf /lib/x86_64-linux-gnu/libyaml-cpp.so.0.8 /lib/x86_64-linux-gnu/libyaml-cpp.so.0.7 2>/dev/null || true && \
    /bin/bash -c 'if [[ "$BUILD_OPTION" = "--sanitize" ]]; then DEBIAN_FRONTEND=noninteractive apt-get install --yes \
        libasan8 \
        libubsan1; fi' && \
    apt-get clean -y && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /opt/oai-gnb/bin
# Staged by build_oai_gnb_quick.sh (outside openairinterface5g .dockerignore).
# OAI_BIN_SHA changes when the staged binary changes and busts BuildKit cache for COPY+.
ARG OAI_BIN_SHA=unknown
COPY nws/build_scripts/staging/nr-softmodem ./
RUN echo "packaged nr-softmodem sha=${OAI_BIN_SHA}"
COPY openairinterface5g/docker/scripts/gnb_entrypoint.sh ./entrypoint.sh
COPY openairinterface5g/docker/scripts/check-prach-io.sh ./check-prach-io.sh

# All runtime .so from local cmake build (must match nr-softmodem)
COPY nws/build_scripts/staging/libs/*.so /usr/local/lib/

COPY --from=gnb-base /usr/local/bin/uhd_find_devices /usr/local/bin
COPY --from=gnb-base /usr/local/lib/libuhd.so.4.8.0 /usr/local/lib
COPY --from=gnb-base /usr/local/lib/uhd/utils/uhd_images_downloader.py /opt/oai-gnb/bin
COPY nws/build_scripts/staging/flexric/lib/flexric/ /usr/local/lib/flexric/
COPY --from=gnb-base /usr/local/lib/libbladeRF* /usr/local/lib/

RUN /bin/bash -c "ln -s /usr/local/lib/liboai_usrpdevif.so /usr/local/lib/liboai_device.so" && \
    ldconfig && \
    echo "---- quick build: ldd nr-softmodem ----" && \
    ldd /opt/oai-gnb/bin/nr-softmodem

WORKDIR /opt/oai-gnb
COPY --from=gnb-base /usr/local/bin/yq /usr/local/bin/yq
COPY --from=gnb-base /tini /tini
ENTRYPOINT ["/tini", "-v", "--", "/opt/oai-gnb/bin/entrypoint.sh"]
CMD ["/opt/oai-gnb/bin/nr-softmodem"]
